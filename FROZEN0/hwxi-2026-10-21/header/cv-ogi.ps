%%BeginDocument: OGIlogo.ps
%!PS-Adobe-2.0 EPSF-2.0
%%Creator: Michael Wolfe, 1994
%%Title: ogilogo.ps
%%CreationDate: Fri Aug 26 00:00:00 1994
%%Pages: 1
%%PageOrder: Ascend
%%BoundingBox: 0 0 100 100
%%EndComments
100 0 0
/black { 0 setgray } def
/black { 0.7 0 0 setrgbcolor } def
% READ THIS:
% You can make several changes in the lines above
% The first line gives the 'size' and 'x' and 'y' offsets of the logo
% in Postscript points.  A line of '72 72 144' makes a 1-inch logo
% 1 inch from the right and 2 inches up
% Choose one of the next two lines to define the color.
% Choose '0 setgray' for true black
% Choose '1 0 0 setrgbcolor' for red, or change the Red-Green-Blue ratios 
% (keep them between 0 and 1).  Or, for the adventurous, change that line
% to 'h s b sethsbcolor' for Hue, Saturation and Brightness.
% You shouldn't have to touch anything below here.
% If you want to use this for an EPS file, set the 'BoundingBox' to:
%	BoundingBox: x y x+size y+size
% where 'size x y' is the first noncomment line in postscript units
% Michael Wolfe
gsave
/Y exch def /X exch def /size exch def
/white { 1 setgray } def
% Operator to multiply by size
%	w msize w
/msize { size mul } def
% Maximum of two numbers
%	a b max c
/max { 2 copy le { exch } if pop } def
% Minimum of two numbers
%	a b min c
/min { 2 copy ge { exch } if pop } def
% Operator to multiply (x,y) by size and offset by (X,Y)
%	x y moff x y
/moff { exch 0 max 1 min msize X add exch 0 max 1 min msize Y add } def
% Moveto operator, scale and offset
%	x y smove -
/smove { moff moveto } def
% Lineto operator, scale and offset
%	x y sline -
/sline { moff lineto } def
% arc operator, scale and offset, center at x,y, radius r, counterclockwise from ang1 to ang2
%	x y r ang1 ang2 sarc -
/sarc { /ang2 exch def /ang1 exch def /r exch def moff r msize ang1 ang2 arc } def
% arcn operator, scale and offset, center x,y, radius r, clocksize from ang1 to ang2
%	x y r ang1 ang2 sarcn -
/sarcn { /ang2 exch def /ang1 exch def /r exch def moff r msize ang1 ang2 arcn } def
% add two (x,y) vectors
%	x1 y1 x2 y2 addv x y
/addv { /y exch def /x exch def y add exch x add exch } def
% subtract two (x,y) vectors
%	x1 y1 x2 y2 subv x y
/subv { /y exch def /x exch def y sub exch x sub exch } def
% Anchor points i
%	i anchor x1 y1 x2 y2
/anchor
{ 0.12 mul
  dup neg 1 add 1 min exch
  dup 1 add 1 min exch
  dup neg 0 max exch
  0 max } def
% Draw Anchor line i
%	/loff w def /lsize w def i anchorline -
/anchorline
{ anchor
  2 copy dup 0 ne { 0 loff neg }{ loff 0 } ifelse addv smove
  dup 0 ne { 0 loff neg lsize sub }{ loff lsize add 0 } ifelse addv sline
  2 copy 1 index 1 eq { 0 loff neg lsize sub }{ loff lsize add 0 } ifelse addv sline
  1 index 1 eq { 0 loff neg }{ loff 0 } ifelse addv sline
  closepath fill } def
% do all 11 Anchor lines
%	loff lsize allanchorlines -
/allanchorlines { /lsize exch def /loff exch def 5 -1 -5 { anchorline } for } def
% Precompute some values
% atan(1/4)
/AT4 1 4 atan def
/arclet { 0.185 0.185 } def
newpath
%
% first big arclet
%
black
0 0.5 smove
0.5 0.5 0.5 180 270 sarc
0.6 0 sline
0.6 0 arclet addv sline
0.5 0.5 arclet addv 0.5 270 AT4 add 180 AT4 sub sarcn
0 0.6 sline
fill
white	0 0.048 allanchorlines	% Anchorlines
black	0.048 0.048 allanchorlines	% Anchorlines
%
% second big arclet
%
black
0 0.5 arclet addv smove
0.5 0.5 arclet addv 0.5 180 AT4 sub 270 AT4 add sarc
0.6 0 arclet addv sline
0.6 0 arclet addv arclet addv sline
0.5 0.5 arclet addv arclet addv 0.5 270 180 sarcn
0 0.6 arclet addv sline
fill
%
% third big arclet
%
white
1 0.5 smove
0.5 0.5 0.5 0 90 sarc
0.4 1 sline
0.4 1 arclet subv sline
0.5 0.5 arclet subv 0.5 90 AT4 add 0 AT4 sub sarcn
1 0.4 sline
fill
black	0.096 0.024 allanchorlines	% Anchorlines
white	0.0 0.024 allanchorlines	% Anchorlines
% upper right arc
black	1 1 smove	0.5 0.5 0.5 0 90 sarc		fill
% lower left arc
black	0 0 smove	0.5 0.5 0.5 180 270 sarc	fill
% upper left triangle
0 1 smove	0 0.6 sline	0.4 1 sline			fill
% lower left triangle
1 0 smove	0.6 0 sline	1 0.4 sline			fill
showpage
grestore
%%Trailer


